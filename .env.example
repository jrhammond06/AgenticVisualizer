# Copy this file to .env and fill in your OpenRouter details.

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model name. OpenRouter uses provider/model slugs, e.g.:
MODEL_NAME=openai/gpt-4o-mini
# MODEL_NAME=anthropic/claude-3.5-haiku
# MODEL_NAME=google/gemini-flash-1.5
# MODEL_NAME=meta-llama/llama-3.1-8b-instruct

# Referee model. Defaults to a stronger model because the referee needs to
# parse structured output and enforce nuanced rules reliably.
REFEREE_MODEL_NAME=~anthropic/claude-sonnet-latest

# Optional: OpenRouter uses these for rankings/attribution
SITE_URL=http://localhost:8000
SITE_NAME=AgenticVisualizer

# Optional: if you're behind a corporate proxy, uncomment and set these
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080

# Optional tuning
MAX_TURNS_DEFAULT=8
MIN_TURNS_DEFAULT=2
REQUEST_TIMEOUT=25.0

# Token budgets for LLM calls. Increase these when using reasoning models,
# because reasoning tokens count against the same budget as the final answer.
AGENT_MAX_TOKENS=120
REFEREE_MAX_TOKENS=400

# Optional: path to a JSONL file that records every LLM request and verbatim
# response for debugging. Set to an empty string to disable.
LLM_LOG_FILE=llm_calls.jsonl
