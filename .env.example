# Copy this file to .env and fill in your values.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default). On Vultr/production, point this at your persistent-volume mount.
# e.g. DATABASE_URL=sqlite:////data/agenticvisualizer.db
DATABASE_URL=sqlite:///./agenticvisualizer.db

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model name. OpenRouter uses provider/model slugs, e.g.:
MODEL_NAME=openai/gpt-4o-mini
# MODEL_NAME=anthropic/claude-3.5-haiku
# MODEL_NAME=google/gemini-flash-1.5

# Referee model — needs structured-output reliability.
REFEREE_MODEL_NAME=anthropic/claude-sonnet-4-5

# ── Deployment (Vultr / production) ───────────────────────────────────────────
# Set SITE_URL to your public domain once deployed.
SITE_URL=http://localhost:8000
SITE_NAME=AgenticVisualizer

# ── Optional tuning ───────────────────────────────────────────────────────────
MAX_TURNS_DEFAULT=8
MIN_TURNS_DEFAULT=2
REQUEST_TIMEOUT=25.0
AGENT_MAX_TOKENS=120
REFEREE_MAX_TOKENS=400
LLM_LOG_FILE=llm_calls.jsonl
